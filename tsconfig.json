{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "lib": ["ESNext"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "types": ["node", "jest"]  // 👈 Added "jest" here
  },
  "include": ["src/**/*", "tests/**/*"] // 👈 Tells TypeScript to include the tests folder in type safety mapping
}
